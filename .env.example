# Copy to .env (git-ignored). Never commit real values. Never paste secrets into chat.
# --- OpenSky Network MinIO (competition data + team submission bucket) ---
OSN_S3_ENDPOINT=s3.opensky-network.org
# These are the MinIO S3 keys. Generate them in the MinIO *console* at
# https://s3-console.opensky-network.org/access-keys (Login with SSO -> Create access key). The host above,
# s3.opensky-network.org, is the S3 API endpoint and has no web UI. The OpenSky *API client*
# (client_id `<user>-api-client` + secret) is a different credential that the S3 endpoint rejects with
# InvalidAccessKeyId - see docs/05 section 1.
# The access key is accepted under any of: OSN_ACCESS_KEY, OSN_ID, OSN_ACCESS_KEY_ID, OSN_KEY_ID
OSN_ACCESS_KEY=
# The secret is accepted under any of: OSN_SECRET_KEY, OSN_SECRET, OSN_SECRET_ACCESS_KEY
OSN_SECRET_KEY=
# Set the competition bucket to prc-2026-datasets (the 2026 files): download_all(), `make download` and the
# download step of `make bootstrap` fail without it. The bucket literally named "competition-data" holds the 2024
# edition, not the 2026 files. `.venv/bin/python -m prc.doctor` lists the buckets once the credentials work.
# The team bucket and team name are only needed for submissions.
OSN_COMPETITION_BUCKET=
OSN_TEAM_BUCKET=
PRC_TEAM_NAME=
# --- Snowflake (only on a machine that is allowed to hold credentials; the Claude sandbox uses MCP instead) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=PRC_ROLE
SNOWFLAKE_WAREHOUSE=PRC_WH
SNOWFLAKE_DATABASE=PRC_DC2026
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# --- local paths ---
PRC_DATA_DIR=./data
