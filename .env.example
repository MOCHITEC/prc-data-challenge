# Copy to .env (git-ignored). Never commit real values. Never paste secrets into chat.
# --- OpenSky Network MinIO (competition data + team submission bucket) ---
OSN_S3_ENDPOINT=s3.opensky-network.org
OSN_ACCESS_KEY=
OSN_SECRET_KEY=
OSN_COMPETITION_BUCKET=competition-data
OSN_TEAM_BUCKET=
PRC_TEAM_NAME=
# --- Snowflake (only on a machine that is allowed to hold credentials; the Claude sandbox uses MCP instead) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=PRC_ROLE
SNOWFLAKE_WAREHOUSE=PRC_WH
SNOWFLAKE_DATABASE=PRC_DC2026
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# --- local paths ---
PRC_DATA_DIR=./data
